generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  families      Family[]     @relation("FamilyCreator")
  comments      Comment[]
  personsAdded  Person[]     @relation("PersonCreator")
  chatMessages  ChatMessage[]
  albumsCreated Album[]      @relation("AlbumCreator")
  mediaUploaded MediaAsset[] @relation("MediaUploader")
  occasionsCreated Occasion[] @relation("OccasionCreator")
  mediaComments MediaComment[]
  mediaLikes    MediaLike[]
  notifications Notification[]
  linkedPersons Person[]     @relation("LinkedPerson")
  dndEnabled    Boolean      @default(false)
  friendshipsRequested Friendship[] @relation("FriendRequester")
  friendshipsReceived  Friendship[] @relation("FriendAddressee")
  directMessagesSent DirectMessage[] @relation("DMSender")
  directMessagesReceived DirectMessage[] @relation("DMReceiver")
  familiesApproving Family[] @relation("FamilyApprover")
  riddlesCreated    Riddle[] @relation("RiddleCreator")
  riddlesSolved     Riddle[] @relation("RiddleSolver")
  pointLogs         PointLog[]
  listingsCreated   Listing[] @relation("ListingCreator")
  listingClaims     ListingClaim[]
  voicesRecorded    PersonVoice[] @relation("VoiceRecorder")
  mediaViewers      MediaViewer[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Family {
  id          String       @id @default(cuid())
  name        String
  description String?
  photo       String?
  inviteCode  String       @unique
  requireApproval Boolean  @default(false)
  approverUserId String?
  approverUser User?       @relation("FamilyApprover", fields: [approverUserId], references: [id])
  createdAt   DateTime     @default(now())
  createdById String
  createdBy   User         @relation("FamilyCreator", fields: [createdById], references: [id])
  memberships Membership[]
  persons     Person[]
  chatMessages ChatMessage[]
  albums       Album[]
  media        MediaAsset[]
  occasions    Occasion[]
  riddles      Riddle[]
  pointLogs    PointLog[]
  listings     Listing[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  familyId  String
  role      String   @default("MEMBER")
  points    Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
}

model Person {
  id          String   @id @default(cuid())
  familyId    String
  firstName   String
  lastName    String?
  nickname    String?
  gender      String
  photo       String?
  birthDate   String?
  deathDate   String?
  birthPlace  String?
  occupation  String?
  bio         String?
  source      String?
  isDeceased  Boolean  @default(false)
  isRoot      Boolean  @default(false)
  fatherId    String?
  motherId    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("PersonCreator", fields: [createdById], references: [id])
  father      Person?  @relation("FatherChildren", fields: [fatherId], references: [id], onDelete: SetNull)
  mother      Person?  @relation("MotherChildren", fields: [motherId], references: [id], onDelete: SetNull)
  childrenAsFather Person[] @relation("FatherChildren")
  childrenAsMother Person[] @relation("MotherChildren")
  spouseLinksA SpouseLink[] @relation("SpouseA")
  spouseLinksB SpouseLink[] @relation("SpouseB")
  comments    Comment[]
  mediaTags   PersonTag[]
  lifeEvents  LifeEvent[]
  voices      PersonVoice[]
  linkedUserId String?
  status      String      @default("APPROVED")
  linkedUser  User?       @relation("LinkedPerson", fields: [linkedUserId], references: [id])
  invites     OccasionInvite[]

  @@index([familyId])
  @@index([fatherId])
  @@index([motherId])
}

model SpouseLink {
  id        String   @id @default(cuid())
  aId       String
  bId       String
  status    String   @default("MARRIED")
  createdAt DateTime @default(now())
  a         Person   @relation("SpouseA", fields: [aId], references: [id], onDelete: Cascade)
  b         Person   @relation("SpouseB", fields: [bId], references: [id], onDelete: Cascade)

  @@unique([aId, bId])
}

model Comment {
  id        String   @id @default(cuid())
  personId  String
  userId    String
  text      String
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  text      String
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

model Album {
  id          String       @id @default(cuid())
  familyId    String
  occasionId  String?
  title       String
  description String?
  createdById String
  createdAt   DateTime     @default(now())
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("AlbumCreator", fields: [createdById], references: [id])
  media       MediaAsset[]
  occasion    Occasion?    @relation(fields: [occasionId], references: [id], onDelete: SetNull)

  @@index([familyId])
}

model MediaAsset {
  id          String      @id @default(cuid())
  familyId    String
  albumId     String?
  kind        String      @default("PHOTO")
  docType     String?
  title       String?
  caption     String?
  fileData    String
  mime        String      @default("image/jpeg")
  visibility  String      @default("FAMILY")
  uploadedById String
  createdAt   DateTime    @default(now())
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  album       Album?      @relation(fields: [albumId], references: [id], onDelete: SetNull)
  uploadedBy  User        @relation("MediaUploader", fields: [uploadedById], references: [id])
  personTags  PersonTag[]
  viewers     MediaViewer[]
  comments    MediaComment[]
  likes       MediaLike[]

  @@index([familyId])
  @@index([albumId])
}

model PersonTag {
  id          String     @id @default(cuid())
  mediaId     String
  personId    String
  createdAt   DateTime   @default(now())
  media       MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person      Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([mediaId, personId])
  @@index([personId])
}

model Occasion {
  id          String   @id @default(cuid())
  familyId    String
  title       String
  type        String   @default("OTHER")
  date        String
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("OccasionCreator", fields: [createdById], references: [id])
  albums      Album[]
  invites     OccasionInvite[]

  @@index([familyId, date])
}

model MediaComment {
  id        String     @id @default(cuid())
  mediaId   String
  userId    String
  text      String
  createdAt DateTime   @default(now())
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaId])
}

model MediaLike {
  id        String     @id @default(cuid())
  mediaId   String
  userId    String
  createdAt DateTime   @default(now())
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  text      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model OccasionInvite {
  id         String   @id @default(cuid())
  occasionId String
  personId   String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([occasionId, personId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING ACCEPTED DECLINED
  createdAt   DateTime @default(now())
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model DirectMessage {
  id        String    @id @default(cuid())
  senderId  String
  receiverId String
  text      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  sender    User      @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User      @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
}

model Riddle {
  id          String    @id @default(cuid())
  familyId    String
  question    String
  answer      String
  reward      Int       @default(10)
  solvedById  String?
  solvedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("RiddleCreator", fields: [createdById], references: [id])
  solvedBy    User?     @relation("RiddleSolver", fields: [solvedById], references: [id])

  @@index([familyId, solvedById])
}

model PointLog {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  points    Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, userId, createdAt])
}

model Listing {
  id          String          @id @default(cuid())
  familyId    String
  kind        String          @default("SELL") // SELL | GIFT
  title       String
  description String?
  price       Int?
  photo       String?
  status      String          @default("AVAILABLE") // AVAILABLE | CLAIMED | DONE
  claimedById String?
  createdById String
  createdAt   DateTime        @default(now())
  family      Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("ListingCreator", fields: [createdById], references: [id])
  claims      ListingClaim[]

  @@index([familyId, status])
}

model ListingClaim {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  message   String?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
}

model LifeEvent {
  id        String   @id @default(cuid())
  personId  String
  year      String?
  title     String
  place     String?
  notes     String?
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model PersonVoice {
  id          String   @id @default(cuid())
  personId    String
  dataUrl     String
  durationSec Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  recordedBy  User     @relation("VoiceRecorder", fields: [createdById], references: [id])

  @@index([personId])
}

model MediaViewer {
  id        String   @id @default(cuid())
  mediaId   String
  userId    String
  createdAt DateTime @default(now())
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId])
}
